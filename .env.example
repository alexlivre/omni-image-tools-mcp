# Environment configuration for omni-image-tools-mcp
# Copy this file to .env and fill in your values

# ===========================================
# PROVIDER CONFIGURATION
# ===========================================

# Provider selection (ollama, openrouter, openai, lmstudio)
OMNI_VISION_PROVIDER=openrouter

# API Key (required for openrouter and openai)
OMNI_VISION_API_KEY=your-api-key-here

# Default model (provider-specific)
# OpenRouter: qwen/qwen3-vl-32b-instruct, google/gemini-2.5-flash, etc.
# OpenAI: gpt-4o, gpt-5.4-mini, etc.
# Ollama: qwen3-vl:4b, llava:latest, etc.
OMNI_VISION_DEFAULT_MODEL=qwen/qwen3-vl-32b-instruct

# Timeout in seconds
OMNI_VISION_TIMEOUT=120

# ===========================================
# OLLAMA CONFIGURATION
# ===========================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ALLOWED_MODELS=qwen3-vl:4b,qwen3-vl:2b
OLLAMA_AUTO_PULL=false

# ===========================================
# LM STUDIO CONFIGURATION
# ===========================================

LMSTUDIO_BASE_URL=http://localhost:1234

# ===========================================
# TEST CONFIGURATIONS
# ===========================================

# OpenRouter Test:
# OMNI_VISION_PROVIDER=openrouter
# OMNI_VISION_API_KEY=sk-or-v1-...
# OMNI_VISION_DEFAULT_MODEL=qwen/qwen3-vl-32b-instruct

# OpenAI Test:
# OMNI_VISION_PROVIDER=openai
# OMNI_VISION_API_KEY=sk-proj-...
# OMNI_VISION_DEFAULT_MODEL=gpt-5.4-mini

# Ollama Test (local):
# OMNI_VISION_PROVIDER=ollama
# OMNI_VISION_DEFAULT_MODEL=qwen3-vl:4b
